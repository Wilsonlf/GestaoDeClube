<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Checagem de Ingressos · Painel Administrativo</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Anton&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css" />
  <script src="https://unpkg.com/html5-qrcode@2.3.8/html5-qrcode.min.js"></script>
</head>
<body class="admin-body">
<div class="admin-shell">
  <%- include('../partials/admin-sidebar', { active: 'checagem' }) %>

  <main class="admin-main">
    <%- include('../partials/admin-topbar') %>

    <div class="admin-content">
      <div class="admin-content-head mb-lg">
        <div>
          <h1>Checagem de Ingressos</h1>
          <p class="muted" style="font-size:13px; margin-top:4px;">Escaneie o QR Code do ingresso na entrada, ou busque pelo CPF se a leitura falhar.</p>
        </div>
      </div>

      <div class="form-grid form-grid--2col" style="align-items:start;">

        <div class="form-panel">
          <h2 style="font-size:15px; margin-bottom:12px;">Câmera</h2>
          <div id="reader" style="width:100%; max-width:360px; border-radius:8px; overflow:hidden;"></div>
          <div class="form-actions" style="margin-top:14px;">
            <button type="button" id="btn-iniciar-camera" class="btn btn-primary">Ligar câmera</button>
            <button type="button" id="btn-parar-camera" class="btn btn-secondary" disabled>Parar</button>
          </div>
          <p id="camera-erro" class="form-alert form-alert--error mb-md" style="display:none; margin-top:12px;"></p>
        </div>

        <div class="form-panel">
          <h2 style="font-size:15px; margin-bottom:12px;">Buscar por CPF</h2>
          <p class="muted" style="font-size:12px; margin-bottom:10px;">Use quando não for possível ler o QR Code.</p>
          <div class="form-group">
            <label for="cpf-busca" class="form-label">CPF do comprador</label>
            <input type="text" id="cpf-busca" class="form-control" placeholder="Somente números" inputmode="numeric" />
          </div>
          <div class="form-actions">
            <button type="button" id="btn-buscar-cpf" class="btn btn-primary">Buscar ingresso</button>
          </div>

          <div id="lista-cpf" style="margin-top:16px;"></div>
        </div>

      </div>

      <div id="resultado" class="form-panel" style="margin-top:20px; display:none;">
        <h2 style="font-size:15px; margin-bottom:12px;">Resultado</h2>
        <div id="resultado-conteudo"></div>
      </div>

    </div>
  </main>
</div>

<script>
(function () {
  const btnIniciar = document.getElementById('btn-iniciar-camera');
  const btnParar = document.getElementById('btn-parar-camera');
  const elCameraErro = document.getElementById('camera-erro');
  const elResultado = document.getElementById('resultado');
  const elResultadoConteudo = document.getElementById('resultado-conteudo');
  const btnBuscarCpf = document.getElementById('btn-buscar-cpf');
  const elCpfBusca = document.getElementById('cpf-busca');
  const elListaCpf = document.getElementById('lista-cpf');

  const INTERVALO_MESMO_QR_MS = 10000;
  const MENSAGEM_SESSAO = 'Sua sessão expirou. Recarregue a página e faça login novamente.';

  let leitor = null;
  let escaneando = false;
  let enviando = false;
  let ultimoHash = null;
  let ultimoHashEm = 0;
  const liberadosNestaTela = new Set();

  function escapar(valor) {
    return String(valor ?? '')
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#39;');
  }

  function formatarDataHora(iso) {
    if (!iso) return '';
    return new Date(iso).toLocaleString('pt-BR');
  }

  function mostrarResultado(html) {
    elResultadoConteudo.innerHTML = html;
    elResultado.style.display = 'block';
  }

  function badge(classe, texto) {
    return `<span class="badge ${classe}">${escapar(texto)}</span>`;
  }

  function cardIngresso(ingresso, statusHtml) {
    return `
      <div style="display:flex; flex-direction:column; gap:6px;">
        ${statusHtml}
        <p><strong>Comprador:</strong> ${escapar(ingresso.comprador.nome)} — CPF ${escapar(ingresso.comprador.cpf || 'não informado')}</p>
        <p><strong>Partida:</strong> ${escapar(ingresso.partida.nome)} · ${escapar(formatarDataHora(ingresso.partida.dataPartida))}</p>
        <p><strong>Local:</strong> ${escapar(ingresso.partida.local)}</p>
        <p><strong>Quantidade:</strong> ${escapar(ingresso.quantidade)}</p>
        ${ingresso.dataCheckin ? `<p class="muted" style="font-size:12px;">Validado em ${escapar(formatarDataHora(ingresso.dataCheckin))}</p>` : ''}
      </div>
    `;
  }

  async function postarJson(url, corpo) {
    const resposta = await fetch(url, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(corpo),
    });
    const tipo = resposta.headers.get('content-type') || '';
    if (resposta.redirected || !tipo.includes('application/json')) {
      throw new Error(MENSAGEM_SESSAO);
    }
    return { resposta, dados: await resposta.json() };
  }

  async function validar(url, corpo) {
    mostrarResultado(badge('badge-pending', 'Validando...'));
    try {
      const { resposta, dados } = await postarJson(url, corpo);
      if (resposta.ok) {
        mostrarResultado(cardIngresso(dados.ingresso, badge('badge-success', '✓ Entrada liberada')));
      } else if (dados.ingresso) {
        mostrarResultado(cardIngresso(dados.ingresso, badge('badge-danger', dados.erro)));
      } else {
        mostrarResultado(badge('badge-danger', dados.erro || 'Não foi possível validar o ingresso.'));
      }
      return resposta.ok;
    } catch (erro) {
      const mensagem = erro.message === MENSAGEM_SESSAO ? MENSAGEM_SESSAO : 'Erro de conexão. Tente novamente.';
      mostrarResultado(badge('badge-danger', mensagem));
      return false;
    }
  }

  async function aoLerQr(textoLido) {
    const hash = textoLido.trim();
    const agora = Date.now();
    if (enviando || liberadosNestaTela.has(hash)) return;
    if (hash === ultimoHash && agora - ultimoHashEm < INTERVALO_MESMO_QR_MS) return;

    enviando = true;
    ultimoHash = hash;
    ultimoHashEm = agora;
    try {
      const ok = await validar('/admin/checagem/validar', { hash });
      if (ok) liberadosNestaTela.add(hash);
    } finally {
      enviando = false;
    }
  }

  btnIniciar.addEventListener('click', async () => {
    elCameraErro.style.display = 'none';
    if (typeof Html5Qrcode === 'undefined') {
      elCameraErro.textContent = 'Biblioteca de leitura de QR não carregou. Verifique a conexão com a internet.';
      elCameraErro.style.display = 'block';
      return;
    }

    try {
      leitor = new Html5Qrcode('reader');
      await leitor.start(
        { facingMode: 'environment' },
        { fps: 10, qrbox: 240 },
        (textoLido) => aoLerQr(textoLido),
        () => {}
      );
      escaneando = true;
      btnIniciar.disabled = true;
      btnParar.disabled = false;
    } catch (erro) {
      elCameraErro.textContent = 'Não foi possível acessar a câmera. Verifique a permissão do navegador.';
      elCameraErro.style.display = 'block';
    }
  });

  btnParar.addEventListener('click', async () => {
    if (leitor && escaneando) {
      await leitor.stop();
      leitor.clear();
      escaneando = false;
    }
    btnIniciar.disabled = false;
    btnParar.disabled = true;
  });

  async function buscarPorCpf() {
    const cpf = elCpfBusca.value.replace(/\D/g, '');
    if (cpf.length !== 11) {
      elListaCpf.innerHTML = badge('badge-danger', 'Digite os 11 números do CPF.');
      return;
    }

    elListaCpf.innerHTML = badge('badge-pending', 'Buscando...');
    btnBuscarCpf.disabled = true;
    try {
      const { resposta, dados } = await postarJson('/admin/checagem/buscar-cpf', { cpf });
      if (!resposta.ok) {
        elListaCpf.innerHTML = badge('badge-danger', dados.erro || 'Não foi possível buscar o CPF.');
        return;
      }

      elListaCpf.innerHTML = dados.ingressos.map((ingresso) => {
        const jaUsado = ingresso.statusCheckin === 'utilizado';
        return `
          <div class="form-panel" style="margin-top:10px; padding:12px;">
            <p><strong>${escapar(ingresso.partida.nome)}</strong> · ${escapar(formatarDataHora(ingresso.partida.dataPartida))}</p>
            <p class="muted" style="font-size:12px;">Quantidade: ${escapar(ingresso.quantidade)}</p>
            ${jaUsado
              ? badge('badge-pending', `Já utilizado em ${formatarDataHora(ingresso.dataCheckin)}`)
              : !ingresso.entradaLiberadaAgora
                ? badge('badge-pending', 'Ingresso de outra partida (fora do horário de entrada)')
                : `<button type="button" class="btn btn-primary" data-validar-compra="${escapar(ingresso.id)}">Confirmar entrada</button>`}
          </div>
        `;
      }).join('');

      elListaCpf.querySelectorAll('[data-validar-compra]').forEach((botao) => {
        botao.addEventListener('click', async () => {
          botao.disabled = true;
          botao.textContent = 'Validando...';
          const ok = await validar('/admin/checagem/validar-manual', { compraId: botao.dataset.validarCompra, cpf });
          if (ok) {
            botao.replaceWith(Object.assign(document.createElement('span'), {
              className: 'badge badge-success',
              textContent: '✓ Entrada liberada',
            }));
          } else {
            botao.disabled = false;
            botao.textContent = 'Confirmar entrada';
          }
        });
      });
    } catch (erro) {
      const mensagem = erro.message === MENSAGEM_SESSAO ? MENSAGEM_SESSAO : 'Erro de conexão. Tente novamente.';
      elListaCpf.innerHTML = badge('badge-danger', mensagem);
    } finally {
      btnBuscarCpf.disabled = false;
    }
  }

  btnBuscarCpf.addEventListener('click', buscarPorCpf);
  elCpfBusca.addEventListener('keydown', (evento) => {
    if (evento.key === 'Enter') {
      evento.preventDefault();
      buscarPorCpf();
    }
  });
})();
</script>
</body>
</html>
