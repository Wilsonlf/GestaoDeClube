<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>Elenco · Painel Administrativo</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Anton&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/css/style.css" />
</head>
<body class="admin-body">
<div class="admin-shell">
  <%- include('../partials/admin-sidebar', { active: 'elenco' }) %>

  <main class="admin-main">
    <%- include('../partials/admin-topbar') %>

    <div class="admin-content">
      <div class="admin-content-head">
        <div>
          <h1>Elenco</h1>
          <p class="muted" style="font-size:13px; margin-top:4px;">Cadastro de jogadores</p>
        </div>
        <a href="/admin/elenco/novo" class="btn btn-primary">+ Novo jogador</a>
      </div>

      <form action="/admin/elenco" method="GET" class="toolbar" style="margin-bottom:16px;">
        <input
          type="search"
          name="busca"
          class="search-input"
          placeholder="Buscar por nome"
          value="<%= typeof termo !== 'undefined' ? termo : '' %>"
        />
      </form>

      <div class="data-table-wrap">
        <table class="data-table">
          <thead>
            <tr><th>Foto</th><th>#</th><th>Nome</th><th>Posição</th><th>Ordem</th><th>Ações</th></tr>
          </thead>
          <tbody>
            <% if (!jogadores || jogadores.length === 0) { %>
            <tr><td colspan="6" class="muted">Nenhum jogador cadastrado ainda.</td></tr>
            <% } %>
            <% (jogadores || []).forEach(function(j) { %>
            <tr>
              <td>
                <% if (j.foto) { %>
                  <img src="<%= j.foto %>" alt="<%= j.nome %>" class="player-photo" style="width:36px; height:36px; margin:0; border-radius:50%; object-fit:cover;" />
                <% } else { %>
                  <div class="player-photo" style="width:36px; height:36px; margin:0; border-radius:50%;"></div>
                <% } %>
              </td>
              <td><%= j.numero || '—' %></td>
              <td class="emphasis"><%= j.nome %></td>
              <td><%= j.posicao || '—' %></td>
              <td><%= j.ordem %></td>
              <td class="row-actions">
                <span class="row-actions-inner">
                  <a href="/admin/elenco/<%= j.id %>/editar" class="btn btn-ghost btn-sm">Editar</a>

                  <form action="/admin/elenco/<%= j.id %>/excluir" method="POST" style="display:inline;" onsubmit="return confirm('Tem certeza que deseja excluir este jogador?');">
                    <button type="submit" class="btn btn-danger btn-sm">Excluir</button>
                  </form>
                </span>
              </td>
            </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  </main>
</div>
</body>
</html>
