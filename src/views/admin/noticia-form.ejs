<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= noticia ? 'Editar Notícia' : 'Nova Notícia' %> · Painel Administrativo</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Anton&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body class="admin-body">
<div class="admin-shell">
  <%- include('../partials/admin-sidebar', { active: 'noticias' }) %>

  <main class="admin-main">
    <%- include('../partials/admin-topbar') %>

    <div class="admin-content">
      <div class="admin-content-head mb-lg">
        <div>
          <h1><%= noticia ? 'Editar Notícia' : 'Nova Notícia' %></h1>
          <p class="muted" style="font-size:13px; margin-top:4px;">
            <%= noticia ? 'Atualize o título e o conteúdo da notícia' : 'Publique uma nova notícia para a área pública' %>
          </p>
        </div>
        <a href="/admin/noticias" class="btn btn-secondary">← Voltar para a lista</a>
      </div>

      <% if (typeof erro !== 'undefined' && erro) { %>
        <div class="form-alert form-alert--error mb-md">
          <%= erro %>
        </div>
      <% } %>

      <div class="form-panel">
        <form action="<%= noticia && noticia.id ? '/admin/noticias/' + noticia.id : '/admin/noticias' %>" method="POST">

          <div class="form-group mb-md">
            <label for="titulo" class="form-label">Título *</label>
            <input
              type="text"
              id="titulo"
              name="titulo"
              class="form-control"
              value="<%= noticia ? noticia.titulo : '' %>"
              required
            />
          </div>

          <div class="form-group mb-lg">
            <label for="conteudo" class="form-label">Conteúdo *</label>
            <textarea
              id="conteudo"
              name="conteudo"
              class="form-control"
              rows="10"
              required
            ><%= noticia ? noticia.conteudo : '' %></textarea>
          </div>

          <div class="form-actions">
            <a href="/admin/noticias" class="btn btn-secondary">Cancelar</a>
            <button type="submit" class="btn btn-primary">
              <%= noticia ? 'Salvar Alterações' : 'Publicar Notícia' %>
            </button>
          </div>

        </form>
      </div>
    </div>
  </main>
</div>
</body>
</html>
