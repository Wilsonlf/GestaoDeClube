<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>Notícias · Painel Administrativo</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Anton&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/css/style.css" />
</head>
<body class="admin-body">
<div class="admin-shell">
  <%- include('../partials/admin-sidebar', { active: 'noticias' }) %>

  <main class="admin-main">
    <%- include('../partials/admin-topbar') %>

    <div class="admin-content">
      <div class="admin-content-head">
        <div>
          <h1>Notícias</h1>
          <p class="muted" style="font-size:13px; margin-top:4px;">Conteúdos publicados para a área pública</p>
        </div>
        <a href="#" class="btn btn-primary">+ Nova notícia</a>
      </div>

      <div class="data-table-wrap">
        <table class="data-table">
          <thead>
            <tr><th>Capa</th><th>Título</th><th>Data</th><th>Ações</th></tr>
          </thead>
          <tbody>
            <%
            var lista = typeof noticias !== 'undefined' ? noticias : [
              { titulo: 'Águia Negra estreia em casa com empate emocionante', data: '03/02/2026' },
              { titulo: 'Reforço de peso assina contrato até 2027', data: '02/02/2026' },
              { titulo: 'Ingressos para próxima rodada já estão à venda', data: '30/01/2026' },
              { titulo: 'Categoria de base conquista título estadual', data: '28/01/2026' }
            ];
            lista.forEach(function(n) { %>
            <tr>
              <td><div class="player-photo" style="width:56px; height:38px; margin:0; border-radius:4px;"></div></td>
              <td class="emphasis"><%= n.titulo %></td>
              <td><%= n.data %></td>
              <td class="row-actions"><a href="#" title="Editar">✏️</a><a href="#" title="Excluir">🗑️</a></td>
            </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  </main>
</div>
</body>
</html>
