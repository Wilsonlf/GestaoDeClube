<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>Notícias · Painel Administrativo</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Anton&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/css/style.css" />
</head>
<body class="admin-body">
<div class="admin-shell">
  <%- include('../partials/admin-sidebar', { active: 'noticias' }) %>

  <main class="admin-main">
    <%- include('../partials/admin-topbar') %>

    <div class="admin-content">
      <div class="admin-content-head">
        <div>
          <h1>Notícias</h1>
          <p class="muted" style="font-size:13px; margin-top:4px;">Conteúdos publicados para a área pública</p>
        </div>
        <a href="/admin/noticias/novo" class="btn btn-primary">+ Nova notícia</a>
      </div>

      <form action="/admin/noticias" method="GET" class="toolbar" style="margin-bottom:16px;">
        <input
          type="search"
          name="busca"
          class="search-input"
          placeholder="Buscar por título"
          value="<%= typeof termo !== 'undefined' ? termo : '' %>"
        />
      </form>

      <div class="data-table-wrap">
        <table class="data-table">
          <thead>
            <tr><th>Título</th><th>Conteúdo</th><th>Publicada em</th><th>Ações</th></tr>
          </thead>
          <tbody>
            <% if (!noticias || noticias.length === 0) { %>
            <tr><td colspan="4" class="muted">Nenhuma notícia cadastrada ainda.</td></tr>
            <% } %>
            <% (noticias || []).forEach(function(n) { %>
            <tr>
              <td class="emphasis"><%= n.titulo %></td>
              <td><%= n.conteudo.length > 60 ? n.conteudo.slice(0, 60) + '…' : n.conteudo %></td>
              <td><%= n.createdAt ? new Date(n.createdAt).toLocaleDateString('pt-BR') : '—' %></td>
              <td class="row-actions">
                <span class="row-actions-inner">
                  <a href="/admin/noticias/<%= n.id %>/editar" class="btn btn-ghost btn-sm">Editar</a>

                  <form action="/admin/noticias/<%= n.id %>/excluir" method="POST" style="display:inline;" onsubmit="return confirm('Tem certeza que deseja excluir esta notícia?');">
                    <button type="submit" class="btn btn-danger btn-sm">Excluir</button>
                  </form>
                </span>
              </td>
            </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  </main>
</div>
</body>
</html>
