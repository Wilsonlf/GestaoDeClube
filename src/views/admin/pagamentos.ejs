<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>Pagamentos · Painel Administrativo</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Anton&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/css/style.css" />
</head>
<body class="admin-body">
<div class="admin-shell">
  <%- include('../partials/admin-sidebar', { active: 'pagamentos' }) %>

  <main class="admin-main">
    <%- include('../partials/admin-topbar') %>

    <div class="admin-content">
      <div class="admin-content-head">
        <div>
          <h1>Pagamentos</h1>
          <p class="muted" style="font-size:13px; margin-top:4px;">Pagamentos realizados pelo clube · Total: R$ <%= Number(total).toLocaleString('pt-BR', { minimumFractionDigits: 2 }) %></p>
        </div>
        <div style="display:flex; gap:10px;">
          <a href="/admin/relatorios" class="btn btn-secondary">Ver relatórios</a>
          <a href="/admin/pagamentos/categorias" class="btn btn-secondary">Categorias</a>
          <a href="/admin/pagamentos/novo" class="btn btn-primary">+ Novo pagamento</a>
        </div>
      </div>

      <div class="data-table-wrap">
        <table class="data-table">
          <thead>
            <tr><th>Descrição</th><th>Categoria</th><th>Valor</th><th>Data do pagamento</th><th>Ações</th></tr>
          </thead>
          <tbody>
            <% if (!pagamentos || pagamentos.length === 0) { %>
            <tr><td colspan="5" class="muted">Nenhum pagamento registrado ainda.</td></tr>
            <% } %>
            <% (pagamentos || []).forEach(function(p) { %>
            <tr>
              <td class="emphasis">
                <%= p.descricao %>
                <% if (p.observacao) { %>
                  <div class="muted" style="font-size:12px; margin-top:2px;"><%= p.observacao %></div>
                <% } %>
              </td>
              <td><%= p.categoria %></td>
              <td>R$ <%= Number(p.valor).toLocaleString('pt-BR', { minimumFractionDigits: 2 }) %></td>
              <td><%= p.dataPagamento ? p.dataPagamento.split('-').reverse().join('/') : '—' %></td>
              <td class="row-actions">
                <span class="row-actions-inner">
                  <a href="/admin/pagamentos/<%= p.id %>/editar" class="btn btn-ghost btn-sm">Editar</a>
                  <form action="/admin/pagamentos/<%= p.id %>/excluir" method="POST" style="display:inline;" onsubmit="return confirm('Tem certeza que deseja excluir este pagamento?');">
                    <button type="submit" class="btn btn-danger btn-sm">Excluir</button>
                  </form>
                </span>
              </td>
            </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  </main>
</div>
</body>
</html>
