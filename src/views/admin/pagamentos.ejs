<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>Pagamentos · Painel Administrativo</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Anton&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/css/style.css" />
</head>
<body class="admin-body">
<div class="admin-shell">
  <%- include('../partials/admin-sidebar', { active: 'pagamentos' }) %>

  <main class="admin-main">
    <%- include('../partials/admin-topbar') %>

    <div class="admin-content">
      <div class="admin-content-head">
        <div>
          <h1>Pagamentos</h1>
          <p class="muted" style="font-size:13px; margin-top:4px;">Registro financeiro do clube</p>
        </div>
        <a href="#" class="btn btn-primary">+ Novo pagamento</a>
      </div>

      <div class="data-table-wrap">
        <table class="data-table">
          <thead>
            <tr><th>Descrição</th><th>Valor</th><th>Data do pagamento</th></tr>
          </thead>
          <tbody>
            <% if (!pagamentos || pagamentos.length === 0) { %>
            <tr><td colspan="3" class="muted">Nenhum pagamento registrado ainda.</td></tr>
            <% } %>
            <% (pagamentos || []).forEach(function(p) { %>
            <tr>
              <td class="emphasis"><%= p.descricao %></td>
              <td>R$ <%= Number(p.valor).toLocaleString('pt-BR', { minimumFractionDigits: 2 }) %></td>
              <td><%= p.data_pagamento ? new Date(p.data_pagamento).toLocaleDateString('pt-BR') : '—' %></td>
            </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  </main>
</div>
</body>
</html>
