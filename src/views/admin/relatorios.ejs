<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>Relatórios · Painel Administrativo</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Anton&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/css/style.css" />
</head>
<body class="admin-body">
<div class="admin-shell">
  <%- include('../partials/admin-sidebar', { active: 'relatorios' }) %>

  <main class="admin-main">
    <%- include('../partials/admin-topbar') %>

    <div class="admin-content">
      <div class="admin-content-head">
        <div>
          <h1>Relatórios</h1>
          <p class="muted" style="font-size:13px; margin-top:4px;">Análise consolidada do clube</p>
        </div>
        <div style="display:flex; gap:10px;">
          <a href="/admin/pagamentos" class="btn btn-secondary">Ver pagamentos</a>
          <a href="/admin/relatorios/pdf?inicio=<%= periodo.inicio %>&fim=<%= periodo.fim %>" class="btn btn-primary">⬇ Exportar PDF</a>
        </div>
      </div>

      <form method="GET" action="/admin/relatorios" class="mb-md" style="display:flex; gap:12px; align-items:flex-end; flex-wrap:wrap;">
        <div class="form-group">
          <label for="inicio" class="form-label">De</label>
          <input type="date" id="inicio" name="inicio" class="form-control" value="<%= periodo.inicio %>" />
        </div>
        <div class="form-group">
          <label for="fim" class="form-label">Até</label>
          <input type="date" id="fim" name="fim" class="form-control" value="<%= periodo.fim %>" />
        </div>
        <button type="submit" class="btn btn-secondary">Filtrar</button>
      </form>

      <div class="kpi-grid">
        <div class="kpi-card">
          <div class="kpi-label">Sócios ativos</div>
          <div class="kpi-value"><%= totalSocios %></div>
        </div>
        <div class="kpi-card kpi-gold">
          <div class="kpi-label">Receita total (planos + ingressos)</div>
          <div class="kpi-value"><%= moeda(receitaTotal) %></div>
        </div>
        <div class="kpi-card">
          <div class="kpi-label">Pagamentos do clube</div>
          <div class="kpi-value"><%= moeda(totalDespesas) %></div>
        </div>
        <div class="kpi-card <%= saldo < 0 ? 'kpi-danger' : '' %>">
          <div class="kpi-label">Saldo do período</div>
          <div class="kpi-value"><%= moeda(saldo) %></div>
        </div>
      </div>

      <div class="report-grid">
        <div class="card">
          <h3 style="font-size:13px; text-transform:none; margin-bottom:6px;">Receita por mês</h3>
          <% if (porMes.length === 0) { %>
            <p class="muted" style="font-size:13px;">Sem movimentação no período.</p>
          <% } else { %>
            <% var maxValor = Math.max.apply(null, porMes.map(function(m){ return m.receita; }).concat([1])); %>
            <div class="bar-chart">
              <% porMes.forEach(function(m) { %>
              <div class="bar" title="<%= moeda(m.receita) %>">
                <span class="stem" style="height:<%= Math.round((m.receita / maxValor) * 100) %>%;"></span>
                <label><%= m.mes %></label>
              </div>
              <% }) %>
            </div>
          <% } %>
        </div>

        <div class="card">
          <h3 style="font-size:13px; text-transform:none; margin-bottom:6px;">Distribuição de sócios por plano</h3>
          <% if (distribuicaoPlanos.length === 0) { %>
            <p class="muted" style="font-size:13px;">Nenhum sócio ativo.</p>
          <% } else {
            var acumulado = 0;
            var stops = distribuicaoPlanos.map(function(p) {
              var inicio = acumulado;
              acumulado += p.pct;
              return p.cor + ' ' + inicio + '% ' + acumulado + '%';
            }).join(', ');
          %>
            <div class="pie" style="background: conic-gradient(<%= stops %>);"></div>
            <div class="pie-legend">
              <% distribuicaoPlanos.forEach(function(p) { %>
              <span><span class="dot" style="background:<%= p.cor %>;"></span><%= p.nome %> — <%= p.qtd %> (<%= p.pct %>%)</span>
              <% }) %>
            </div>
          <% } %>
        </div>
      </div>

      <div class="report-grid" style="margin-top:20px;">
        <div class="data-table-wrap">
          <table class="data-table">
            <thead><tr><th>Partida</th><th>Vendidos</th><th>Utilizados</th><th>Receita</th></tr></thead>
            <tbody>
              <% if (ingressosPorPartida.length === 0) { %>
              <tr><td colspan="4" class="muted">Nenhuma venda aprovada no período.</td></tr>
              <% } %>
              <% ingressosPorPartida.forEach(function(p) { %>
              <tr>
                <td class="emphasis"><%= p.partida %></td>
                <td><%= p.vendidos %></td>
                <td><%= p.utilizados %></td>
                <td><%= moeda(p.receita) %></td>
              </tr>
              <% }) %>
            </tbody>
          </table>
        </div>

        <div class="data-table-wrap">
          <table class="data-table">
            <thead><tr><th>Pagamentos do clube por categoria</th><th>Total</th></tr></thead>
            <tbody>
              <% if (despesasPorCategoria.length === 0) { %>
              <tr><td colspan="2" class="muted">Nenhum pagamento registrado no período.</td></tr>
              <% } %>
              <% despesasPorCategoria.forEach(function(c) { %>
              <tr><td class="emphasis"><%= c.nome %></td><td><%= moeda(c.valor) %></td></tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>

      <% if (pendencias > 0) { %>
        <p class="muted" style="font-size:12px; margin-top:16px;"><%= pendencias %> pagamento(s) de sócios/ingressos aguardando confirmação do Mercado Pago.</p>
      <% } %>
    </div>
  </main>
</div>
</body>
</html>
