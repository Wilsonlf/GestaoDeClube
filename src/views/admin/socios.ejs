<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>Sócios · Painel Administrativo</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Anton&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/css/style.css" />
</head>
<body class="admin-body">
<div class="admin-shell">
  <%- include('../partials/admin-sidebar', { active: 'socios' }) %>

  <main class="admin-main">
    <%- include('../partials/admin-topbar') %>

    <div class="admin-content">
      <div class="admin-content-head">
        <div>
          <h1>Sócios Torcedores</h1>
          <p class="muted" style="font-size:13px; margin-top:4px;">Cadastro e gestão de sócios</p>
        </div>
        <a href="#" class="btn btn-primary">+ Novo sócio</a>
      </div>

      <div class="toolbar" style="margin-bottom:16px;">
        <input type="search" class="search-input" placeholder="Buscar por nome ou CPF" />
      </div>

      <div class="data-table-wrap">
        <table class="data-table">
          <thead>
            <tr>
              <th>Nome</th><th>CPF</th><th>Telefone</th><th>E-mail</th><th>Sócio desde</th><th>Ações</th>
            </tr>
          </thead>
          <tbody>
            <% if (!socios || socios.length === 0) { %>
            <tr><td colspan="6" class="muted">Nenhum sócio cadastrado ainda.</td></tr>
            <% } %>
            <% (socios || []).forEach(function(s) { %>
            <tr>
              <td class="emphasis"><%= s.nome %></td>
              <td><%= s.cpf %></td>
              <td><%= s.telefone || '—' %></td>
              <td><%= s.email || '—' %></td>
              <td><%= s.createdAt ? new Date(s.createdAt).toLocaleDateString('pt-BR') : '—' %></td>
              <td class="row-actions"><a href="#" title="Editar">✏️</a><a href="#" title="Excluir">🗑️</a></td>
            </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  </main>
</div>
</body>
</html>
