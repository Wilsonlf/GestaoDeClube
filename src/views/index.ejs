<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>Esporte Clube Águia Negra</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Anton&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/css/style.css" />
</head>
<body>

<%- include('partials/topbar') %>

<%- include('partials/nav-publico', { active: 'clube' }) %>

<main>

  <section class="section" style="padding-top:32px; padding-bottom:32px;">
    <div class="wrap hero-grid">
      <div class="hero-highlight">
        <span class="eyebrow">Último jogo</span>
        <h1 style="font-size:26px; margin-top:6px;">Águia Negra estreia em casa com empate emocionante</h1>
        <p class="muted" style="margin-top:10px;">Time do técnico Ederson Passos segurou o resultado nos minutos finais diante de mais de 2 mil torcedores no Ninho da Águia.</p>
        <a href="#noticias" class="btn btn-ghost" style="margin-top:16px;">Ler matéria completa</a>
      </div>

      <aside class="card next-match">
        <% if (proximoJogo) { %>
          <span class="eyebrow"><%= proximoJogo.competicao || 'Próximo jogo' %></span>
          <div class="match-row">
            <div class="crest-sm" aria-hidden="true">ECAN</div>
            <div class="match-date">
              <strong><%= new Date(proximoJogo.dataPartida).toLocaleDateString('pt-BR', { day: '2-digit', month: '2-digit' }) %></strong>
              <span class="muted"><%= new Date(proximoJogo.dataPartida).toLocaleTimeString('pt-BR', { hour: '2-digit', minute: '2-digit' }) %>h</span>
            </div>
          </div>
          <p style="margin-top:14px; font-size:14px; font-weight:600;"><%= proximoJogo.partida %></p>
          <p class="muted" style="font-size:13px; margin-top:4px;"><%= proximoJogo.local %></p>
          <a href="/ingressos" class="btn btn-ghost" style="margin-top:16px;">Comprar ingresso</a>
        <% } else { %>
          <span class="eyebrow">Próximo jogo</span>
          <p class="muted" style="margin-top:14px;">Nenhuma partida agendada no momento.</p>
        <% } %>
      </aside>
    </div>
  </section>

  <section class="pennant-cut">
    <div class="wrap" style="display:flex; align-items:center; justify-content:space-between; gap:16px; flex-wrap:wrap;">
      <div>
        <h2 style="font-size:20px;">Seja sócio torcedor Águia Negra</h2>
        <p style="margin:4px 0 0; opacity:.9;">Prioridade nos ingressos e descontos na loja oficial.</p>
      </div>
      <a href="/planos" class="btn btn-gold">Ver planos</a>
    </div>
  </section>

  <section class="section" id="elenco">
    <div class="wrap">
      <span class="eyebrow">Temporada 2026</span>
      <h2 style="font-size:24px; margin-top:6px; margin-bottom:22px;">Nosso elenco</h2>
      <% if (!jogadores || jogadores.length === 0) { %>
        <p class="muted">Nenhum jogador cadastrado ainda.</p>
      <% } else { %>
        <div class="carousel">
          <button type="button" class="carousel-arrow" aria-label="Ver jogadores anteriores" data-carousel-target="elenco-track" data-dir="-1">‹</button>
          <div class="carousel-track" id="elenco-track">
            <% jogadores.forEach(function(j) { %>
              <article class="player-card">
                <div class="player-photo">
                  <% if (j.foto) { %>
                    <img src="<%= j.foto %>" alt="<%= j.nome %>" style="width:100%; height:100%; object-fit:cover;" />
                  <% } else { %>
                    <%= j.numero || '' %>
                  <% } %>
                </div>
                <strong><%= j.nome %></strong>
                <span class="muted"><%= j.posicao || '—' %></span>
              </article>
            <% }) %>
          </div>
          <button type="button" class="carousel-arrow" aria-label="Ver próximos jogadores" data-carousel-target="elenco-track" data-dir="1">›</button>
        </div>
      <% } %>
    </div>
  </section>

  <section class="section" id="noticias" style="padding-top:0;">
    <div class="wrap">
      <div style="display:flex; align-items:flex-end; justify-content:space-between; gap:16px; flex-wrap:wrap; margin-bottom:22px;">
        <div>
          <span class="eyebrow">Fique por dentro</span>
          <h2 style="font-size:24px; margin-top:6px;">Últimas notícias</h2>
        </div>
        <a href="/noticias" class="btn btn-ghost">Ver todas</a>
      </div>

      <% if (!noticiasRecentes || noticiasRecentes.length === 0) { %>
        <p class="muted">Nenhuma notícia publicada ainda.</p>
      <% } else { %>
        <div class="news-grid">
          <% noticiasRecentes.forEach(function(n) { %>
            <a class="card" href="/noticias/<%= n.id %>" style="display:block; color:inherit; text-decoration:none;">
              <span class="muted" style="font-size:12px;">
                <%= n.createdAt ? new Date(n.createdAt).toLocaleDateString('pt-BR') : '' %>
              </span>
              <h3 style="font-size:16px; text-transform:none; margin-top:6px;"><%= n.titulo %></h3>
            </a>
          <% }) %>
        </div>
      <% } %>
    </div>
  </section>

</main>

<footer class="site-footer">
  <div class="wrap">
    <div>
      <div class="sponsors">
        <span>Patrocinadores</span>
        <strong>Sicredi</strong>
        <strong>Airpon</strong>
        <strong>Lojas MM</strong>
        <strong>FFMS</strong>
      </div>
    </div>
    <div class="contact">
      contato@ecan.com.br<br />
      (67) 3000-0000
    </div>
  </div>
  <div class="legal">© 2026 Esporte Clube Águia Negra — Fundado em 1971</div>
</footer>

<script src="/js/main.js"></script>
</body>
</html>
