<%
  const paginaAtual = typeof active !== 'undefined' ? active : '';
  const marcar = (chave) => paginaAtual === chave ? ' aria-current="page"' : '';
  const base = paginaAtual === 'clube' ? '' : '/';
%>
<header class="nav">
  <div class="wrap">
    <div class="nav-menu">
      <ul class="nav-links">
        <li><a href="/"<%- marcar('clube') %>>Clube</a></li>
        <li><a href="/noticias"<%- marcar('noticias') %>>Notícias</a></li>
        <li><a href="<%= base %>#elenco">Elenco</a></li>
      </ul>
      <ul class="nav-links" style="justify-content:flex-end;">
        <li><a href="/estadio"<%- marcar('estadio') %>>Estádio</a></li>
        <li><a href="/ingressos"<%- marcar('ingressos') %>>Ingressos</a></li>
        <li><a href="/planos"<%- marcar('planos') %>>Sócio</a></li>
        <% if (usuarioLogado) { %>
          <li class="nav-user">
            <span><%= usuarioLogado.nome.split(' ')[0] %></span>
          </li>
          <li><a href="/logout">Sair</a></li>
        <% } else { %>
          <li><a href="/login">Login</a></li>
        <% } %>
      </ul>
    </div>
    <div class="nav-crest" aria-hidden="true">ECAN</div>
    <button class="nav-toggle" aria-label="Abrir menu" aria-expanded="false">☰</button>
  </div>
</header>
